{
  "name": "create-egg",
  "version": "3.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Alias for egg-init, so you could use `npm init egg showcase`.",
  "type": "commonjs",
  "dependencies": {
    "egg-init": "3"
  },
  "devDependencies": {
    "@eggjs/bin": "workspace:*",
    "coffee": "catalog:",
    "eslint-config-egg": "catalog:",
    "mocha": "catalog:",
    "c8": "catalog:"
  },
  "bin": "./bin/create-egg.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "npm run lint -- --fix && npm run test-local",
    "test-local": "mocha test/**/*.test.js",
    "cov": "c8 npm run test-local",
    "ci": "npm run lint && npm run cov"
  },
  "eslintIgnore": [
    "coverage",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:eggjs/egg.git",
    "directory": "tools/create-egg"
  },
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "homepage": "https://github.com/eggjs/egg/tree/next/tools/create-egg",
  "files": [
    "bin"
  ],
  "author": "TZ <atian25@qq.com>",
  "license": "MIT"
}
