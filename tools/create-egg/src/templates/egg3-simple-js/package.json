{
  "name": "{{name}}",
  "version": "1.0.0",
  "private": true,
  "description": "hello Egg.js",
  "license": "MIT",
  "author": "{{author}}",
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "start": "egg-scripts start --daemon --title=egg-server-{{name}}",
    "stop": "egg-scripts stop --title=egg-server-{{name}}",
    "dev": "egg-bin dev",
    "test": "npm run lint -- --fix && npm run test:local",
    "test:local": "egg-bin test",
    "cov": "egg-bin cov",
    "lint": "eslint .",
    "ci": "npm run lint && npm run cov"
  },
  "dependencies": {
    "egg": "^3.17.5",
    "egg-scripts": "3"
  },
  "devDependencies": {
    "egg-bin": "6",
    "egg-mock": "5",
    "eslint": "8",
    "eslint-config-egg": "14"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "egg": {
    "declarations": true
  }
}
