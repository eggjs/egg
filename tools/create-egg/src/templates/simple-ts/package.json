{
  "name": "{{name}}",
  "private": true,
  "description": "Hello Egg.js",
  "homepage": "https://github.com/YOUR_USERNAME/YOUR_REPO#readme",
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/YOUR_REPO/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USERNAME/YOUR_REPO.git"
  },
  "type": "module",
  "scripts": {
    "start": "eggctl start --daemon --title=egg-server-{{name}}",
    "stop": "eggctl stop --title=egg-server-{{name}}",
    "dev": "egg-bin dev",
    "test:local": "vitest run",
    "pretest": "npm run clean && npm run lint -- --fix",
    "test": "vitest run",
    "preci": "npm run clean && npm run lint",
    "ci": "vitest run --coverage",
    "postci": "npm run prepublishOnly && npm start && sleep 10 && npm stop && npm run clean",
    "lint": "oxlint --type-aware",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "tsc": "node node_modules/@typescript/native/bin/tsc",
    "clean": "node node_modules/@typescript/native/bin/tsc -b --clean",
    "prepublishOnly": "npm run clean && npm run tsc"
  },
  "dependencies": {
    "@eggjs/scripts": "^4.0.0",
    "egg": "beta"
  },
  "devDependencies": {
    "@eggjs/bin": "beta",
    "@eggjs/mock": "beta",
    "@eggjs/tsconfig": "beta",
    "@types/node": "24",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxlint": "1",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "egg": {
    "typescript": true
  }
}
