{
  "name": "@eggjs/monorepo",
  "version": "4.1.0",
  "private": true,
  "description": "Eggjs framework monorepo",
  "engines": {
    "node": ">= 20.19.0"
  },
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "@eggjs/tsconfig": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "vitest": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "@vitest/ui": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "scripts": {
    "clean": "pnpm -r run clean",
    "build": "pnpm -r run build",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "site:dev": "pnpm --filter=site run dev",
    "site:build": "pnpm --filter=site run build",
    "site:prettier": "pnpm --filter=site run prettier",
    "puml": "puml . --dest ./site",
    "example:commonjs": "pnpm --filter=@examples/helloworld-commonjs run dev",
    "example:typescript": "pnpm --filter=@examples/helloworld-typescript run dev",
    "prepare": "husky"
  },
  "homepage": "https://github.com/eggjs/egg",
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git"
  },
  "license": "MIT"
}
