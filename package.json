{
  "name": "@eggjs/monorepo",
  "version": "4.1.0-beta.11",
  "private": true,
  "description": "Eggjs framework monorepo",
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@eggjs/bin": "workspace:*",
    "@eggjs/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "c8": "catalog:",
    "cross-env": "catalog:",
    "husky": "catalog:",
    "js-yaml": "catalog:",
    "lint-staged": "catalog:",
    "mocha": "catalog:",
    "mochawesome-with-mocha": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "clean": "pnpm -r run clean && rimraf packages/**/dist",
    "build": "pnpm -r run build",
    "lint": "oxlint --type-aware",
    "typecheck": "pnpm clean && pnpm -r run typecheck",
    "pretest": "pnpm -r run pretest && pnpm run clean",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "ci": "pnpm run test:cov",
    "ci:packages": "vitest run --coverage packages/*",
    "ci:tools": "vitest run --coverage tools/*",
    "ci:plugins": "vitest run --coverage plugins/*",
    "postci": "pnpm run build",
    "site:dev": "pnpm --filter=site run dev",
    "site:build": "pnpm --filter=site run build",
    "site:prettier": "pnpm --filter=site run prettier",
    "puml": "puml . --dest ./site",
    "example:commonjs": "pnpm --filter=@examples/helloworld-commonjs run dev",
    "example:typescript": "pnpm --filter=@examples/helloworld-typescript run dev",
    "prepare": "husky",
    "version:patch": "node scripts/version.js patch",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major",
    "version:prerelease": "node scripts/version.js prerelease",
    "version:prepatch": "node scripts/version.js prepatch",
    "version:preminor": "node scripts/version.js preminor",
    "version:premajor": "node scripts/version.js premajor",
    "version:alpha": "node scripts/version.js prerelease --prerelease-tag=alpha",
    "version:beta": "node scripts/version.js prerelease --prerelease-tag=beta",
    "version:rc": "node scripts/version.js prerelease --prerelease-tag=rc"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown --cache",
    "*.{ts,js,json,md,yml}": [
      "prettier --ignore-unknown --write",
      "oxlint --type-aware --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git"
  },
  "license": "MIT"
}
