{
  "name": "@eggjs/monorepo",
  "version": "4.1.0",
  "private": true,
  "description": "Eggjs framework monorepo",
  "engines": {
    "node": ">= 20.19.0"
  },
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "@eggjs/tsconfig": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "vitest": "catalog:",
    "@vitest/ui": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "scripts": {
    "clean": "pnpm -r run clean",
    "build": "pnpm -r run build",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "test:changed": "pnpm -r run test:changed",
    "cov": "vitest run --coverage",
    "ci": "pnpm -r run ci",
    "ci:core": "pnpm --filter=core run ci",
    "ci:utils": "pnpm run cov packages/utils",
    "ci:app": "pnpm --filter=egg run ci:app",
    "ci:cluster1": "pnpm --filter=egg run ci:cluster1",
    "ci:cluster2": "pnpm --filter=egg run ci:cluster2",
    "ci:lib/core": "pnpm --filter=egg run ci:lib/core",
    "ci:lib/plugins": "pnpm --filter=egg run ci:lib/plugins",
    "site:dev": "pnpm --filter=site run dev",
    "site:build": "pnpm --filter=site run build",
    "site:prettier": "pnpm --filter=site run prettier",
    "puml": "puml . --dest ./site",
    "example:commonjs": "pnpm --filter=@examples/helloworld-commonjs run dev",
    "example:typescript": "pnpm --filter=@examples/helloworld-typescript run dev"
  },
  "homepage": "https://github.com/eggjs/egg",
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git"
  },
  "license": "MIT"
}
