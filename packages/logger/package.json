  },
  "devDependencies": {
    "@eggjs/koa": "workspace:*",
    "@eggjs/supertest": "workspace:*",
    "@eggjs/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "coffee": "catalog:",
    "mm": "catalog:",
