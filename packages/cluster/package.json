{
  "name": "@eggjs/cluster",
  "version": "3.0.1",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "cluster manager for egg",
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git",
    "directory": "packages/cluster"
  },
  "keywords": [
    "egg",
    "cluster",
    "process"
  ],
  "author": "dead-horse <dead_horse@qq.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eggjs/cluster/issues"
  },
  "homepage": "https://github.com/eggjs/cluster#readme",
  "dependencies": {
    "@eggjs/utils": "workspace:*",
    "@fengmk2/ps-tree": "catalog:",
    "cfork": "catalog:",
    "cluster-reload": "catalog:",
    "detect-port": "catalog:",
    "egg-logger": "catalog:",
    "get-ready": "catalog:",
    "graceful-process": "catalog:",
    "sendmessage": "catalog:",
    "terminal-link": "catalog:",
    "utility": "catalog:"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/supertest": "workspace:",
    "@eggjs/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "address": "catalog:",
    "coffee": "catalog:",
    "egg": "workspace:*",
    "egg-errors": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "urllib": "catalog:"
  },
  "engines": {
    "node": ">= 20.19.0"
  }
}
