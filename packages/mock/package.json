{
  "name": "@eggjs/mock",
  "version": "6.0.7",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./bootstrap": "./dist/bootstrap.js",
      "./register": "./dist/register.js",
      "./package.json": "./package.json"
    }
  },
  "eggPlugin": {
    "name": "egg-mock"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./register": "./src/register.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "description": "mock server plugin for egg",
  "homepage": "https://github.com/eggjs/mock",
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git",
    "directory": "packages/mock"
  },
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "keywords": [
    "egg",
    "mock"
  ],
  "author": "popomore <sakura9515@gmail.com>",
  "engines": {
    "node": ">= 20.19.0"
  },
  "dependencies": {
    "@eggjs/core": "workspace:*",
    "@eggjs/supertest": "catalog:",
    "@eggjs/utils": "workspace:*",
    "coffee": "catalog:",
    "detect-port": "catalog:",
    "egg-logger": "catalog:",
    "extend2": "catalog:",
    "get-ready": "catalog:",
    "globby": "catalog:",
    "is-type-of": "catalog:",
    "merge-descriptors": "catalog:",
    "mm": "catalog:",
    "sdk-base": "catalog:",
    "urllib": "catalog:",
    "utility": "catalog:"
  },
  "devDependencies": {
    "@eggjs/tegg": "catalog:",
    "@eggjs/tegg-config": "catalog:",
    "@eggjs/tegg-controller-plugin": "catalog:",
    "@eggjs/tegg-plugin": "catalog:",
    "@eggjs/tsconfig": "catalog:",
    "@types/methods": "catalog:",
    "@types/node": "catalog:",
    "egg": "workspace:*",
    "egg-errors": "catalog:",
    "egg-tracer": "catalog:",
    "pedding": "catalog:",
    "tsd": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  }
}
