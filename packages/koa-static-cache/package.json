{
  "name": "@eggjs/koa-static-cache",
  "version": "7.0.2-beta.9",
  "description": "Static cache middleware for koa",
  "keywords": [
    "cache",
    "file",
    "gzip",
    "koa",
    "middleware",
    "sendfile",
    "static"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/packages/koa-static-cache",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "packages/koa-static-cache"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@eggjs/compressible": "^3.0.0",
    "fs-readdir-recursive": "^1.1.0",
    "mime-types": "^3.0.0",
    "utility": "catalog:"
  },
  "devDependencies": {
    "@eggjs/koa": "workspace:*",
    "@eggjs/supertest": "workspace:*",
    "@eggjs/tsconfig": "workspace:*",
    "@types/fs-readdir-recursive": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "ylru": "^2.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
