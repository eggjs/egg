{
  "name": "@eggjs/supertest",
  "description": "SuperAgent driven library for testing HTTP servers",
  "version": "9.0.0-beta.14",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "TJ Holowaychuk",
  "keywords": [
    "bdd",
    "http",
    "request",
    "superagent",
    "tdd",
    "test",
    "testing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git",
    "directory": "packages/supertest"
  },
  "homepage": "https://github.com/eggjs/egg/tree/next/packages/supertest",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@types/superagent": "catalog:",
    "superagent": "catalog:"
  },
  "devDependencies": {
    "@types/body-parser": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "body-parser": "catalog:",
    "cookie-parser": "catalog:",
    "express": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "prepublishOnly": "pnpm run build"
  }
}
