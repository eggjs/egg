{
  "name": "@eggjs/supertest",
  "version": "9.0.0-beta.35",
  "description": "SuperAgent driven library for testing HTTP servers",
  "keywords": [
    "bdd",
    "http",
    "request",
    "superagent",
    "tdd",
    "test",
    "testing"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/packages/supertest",
  "license": "MIT",
  "author": "TJ Holowaychuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "packages/supertest"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent.ts",
    "./error/AssertError": "./src/error/AssertError.ts",
    "./request": "./src/request.ts",
    "./test": "./src/test.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./agent": "./dist/agent.js",
      "./error/AssertError": "./dist/error/AssertError.js",
      "./request": "./dist/request.js",
      "./test": "./dist/test.js",
      "./types": "./dist/types.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsgo --noEmit && tsc --noEmit",
    "lint": "oxlint --type-aware",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@types/superagent": "catalog:",
    "superagent": "catalog:"
  },
  "devDependencies": {
    "@types/body-parser": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "body-parser": "catalog:",
    "cookie-parser": "catalog:",
    "express": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
