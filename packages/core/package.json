{
  "name": "@eggjs/core",
  "version": "7.0.2-beta.9",
  "description": "A core plugin framework based on @eggjs/koa",
  "keywords": [
    "egg",
    "loader"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/packages/core",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "author": "fengmk2 <fengmk2@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@eggjs/extend2": "workspace:*",
    "@eggjs/koa": "workspace:*",
    "@eggjs/path-matching": "workspace:*",
    "@eggjs/router": "workspace:*",
    "@eggjs/utils": "workspace:*",
    "egg-logger": "catalog:",
    "get-ready": "catalog:",
    "globby": "catalog:",
    "is-type-of": "catalog:",
    "node-homedir": "catalog:",
    "performance-ms": "catalog:",
    "ready-callback": "catalog:",
    "tsconfig-paths": "catalog:",
    "utility": "catalog:"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/supertest": "workspace:*",
    "@eggjs/tsconfig": "workspace:*",
    "@types/js-yaml": "catalog:",
    "await-event": "catalog:",
    "coffee": "catalog:",
    "gals": "catalog:",
    "husky": "catalog:",
    "js-yaml": "catalog:",
    "mm": "catalog:",
    "typescript": "catalog:",
    "urllib": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
