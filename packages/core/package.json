{
  "name": "@eggjs/core",
  "version": "6.5.0",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">= 20.19.0"
  },
  "description": "A core plugin framework based on @eggjs/koa",
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git",
    "directory": "packages/core"
  },
  "keywords": [
    "egg",
    "loader"
  ],
  "author": "fengmk2 <fengmk2@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "homepage": "https://github.com/eggjs/egg/tree/monorepo/packages/core#readme",
  "dependencies": {
    "@eggjs/koa": "workspace:*",
    "@eggjs/router": "catalog:",
    "@eggjs/utils": "workspace:*",
    "egg-logger": "catalog:",
    "egg-path-matching": "catalog:",
    "@eggjs/extend2": "workspace:*",
    "get-ready": "catalog:",
    "globby": "catalog:",
    "is-type-of": "catalog:",
    "node-homedir": "catalog:",
    "performance-ms": "catalog:",
    "ready-callback": "catalog:",
    "tsconfig-paths": "catalog:",
    "utility": "catalog:"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/supertest": "workspace:*",
    "@eggjs/tsconfig": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "await-event": "catalog:",
    "coffee": "catalog:",
    "husky": "catalog:",
    "prettier": "catalog:",
    "gals": "catalog:",
    "js-yaml": "catalog:",
    "mm": "catalog:",
    "pedding": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "urllib": "catalog:"
  }
