{
  "name": "@eggjs/core",
  "version": "7.0.0-beta.35",
  "description": "A core plugin framework based on @eggjs/koa",
  "keywords": [
    "egg",
    "loader"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/packages/core",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "author": "fengmk2 <fengmk2@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./base_context_class": "./src/base_context_class.ts",
    "./egg": "./src/egg.ts",
    "./lifecycle": "./src/lifecycle.ts",
    "./loader/context_loader": "./src/loader/context_loader.ts",
    "./loader/egg_loader": "./src/loader/egg_loader.ts",
    "./loader/file_loader": "./src/loader/file_loader.ts",
    "./singleton": "./src/singleton.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/sequencify": "./src/utils/sequencify.ts",
    "./utils/timing": "./src/utils/timing.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./base_context_class": "./dist/base_context_class.js",
      "./egg": "./dist/egg.js",
      "./lifecycle": "./dist/lifecycle.js",
      "./loader/context_loader": "./dist/loader/context_loader.js",
      "./loader/egg_loader": "./dist/loader/egg_loader.js",
      "./loader/file_loader": "./dist/loader/file_loader.js",
      "./singleton": "./dist/singleton.js",
      "./types": "./dist/types.js",
      "./utils": "./dist/utils/index.js",
      "./utils/sequencify": "./dist/utils/sequencify.js",
      "./utils/timing": "./dist/utils/timing.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsgo --noEmit && tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@eggjs/extend2": "workspace:*",
    "@eggjs/koa": "workspace:*",
    "@eggjs/path-matching": "workspace:*",
    "@eggjs/router": "workspace:*",
    "@eggjs/utils": "workspace:*",
    "egg-logger": "catalog:",
    "get-ready": "catalog:",
    "globby": "catalog:",
    "is-type-of": "catalog:",
    "node-homedir": "catalog:",
    "performance-ms": "catalog:",
    "ready-callback": "catalog:",
    "tsconfig-paths": "catalog:",
    "utility": "catalog:"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/supertest": "workspace:*",
    "@eggjs/tsconfig": "workspace:*",
    "@types/js-yaml": "catalog:",
    "await-event": "catalog:",
    "coffee": "catalog:",
    "gals": "catalog:",
    "husky": "catalog:",
    "js-yaml": "catalog:",
    "mm": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "urllib": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
