{
  "name": "@eggjs/cookies",
  "version": "4.0.0-beta.35",
  "description": "cookies module for egg",
  "homepage": "https://github.com/eggjs/egg/tree/next/packages/cookies",
  "license": "MIT",
  "author": "fengmk2 <fengmk2@gmail.com> (https://github.com/fengmk2)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "packages/cookies"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cookie": "./src/cookie.ts",
    "./cookies": "./src/cookies.ts",
    "./error": "./src/error.ts",
    "./keygrip": "./src/keygrip.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./cookie": "./dist/cookie.js",
      "./cookies": "./dist/cookies.js",
      "./error": "./dist/error.js",
      "./keygrip": "./dist/keygrip.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit && tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run lint:fix && vitest run",
    "ci": "vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "should-send-same-site-none": "catalog:",
    "utility": "catalog:"
  },
  "devDependencies": {
    "@eggjs/tsconfig": "workspace:*",
    "beautify-benchmark": "catalog:",
    "benchmark": "catalog:",
    "cookies": "catalog:",
    "keygrip": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
