    "./factory/LoadUnitInstanceFactory": "./src/factory/LoadUnitInstanceFactory.ts",
    "./impl": "./src/impl/index.ts",
    "./impl/ContextInitiator": "./src/impl/ContextInitiator.ts",
    "./impl/ContextObjectGraph": "./src/impl/ContextObjectGraph.ts",
    "./impl/EggAlwaysNewObjectContainer": "./src/impl/EggAlwaysNewObjectContainer.ts",
    "./impl/EggObjectImpl": "./src/impl/EggObjectImpl.ts",
    "./impl/EggObjectUtil": "./src/impl/EggObjectUtil.ts",
    "./impl/ModuleLoadUnitInstance": "./src/impl/ModuleLoadUnitInstance.ts",
    "./model": "./src/model/index.ts",
    "./model/AbstractEggContext": "./src/model/AbstractEggContext.ts",
    "./model/ContextHandler": "./src/model/ContextHandler.ts",
    "./model/EggContext": "./src/model/EggContext.ts",
    "./model/EggObject": "./src/model/EggObject.ts",
    "./model/LoadUnitInstance": "./src/model/LoadUnitInstance.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./factory": "./dist/factory/index.js",
      "./factory/EggContainerFactory": "./dist/factory/EggContainerFactory.js",
      "./factory/EggObjectFactory": "./dist/factory/EggObjectFactory.js",
      "./factory/LoadUnitInstanceFactory": "./dist/factory/LoadUnitInstanceFactory.js",
      "./impl": "./dist/impl/index.js",
      "./impl/ContextInitiator": "./dist/impl/ContextInitiator.js",
      "./impl/ContextObjectGraph": "./dist/impl/ContextObjectGraph.js",
      "./impl/EggAlwaysNewObjectContainer": "./dist/impl/EggAlwaysNewObjectContainer.js",
      "./impl/EggObjectImpl": "./dist/impl/EggObjectImpl.js",
      "./impl/EggObjectUtil": "./dist/impl/EggObjectUtil.js",
      "./impl/ModuleLoadUnitInstance": "./dist/impl/ModuleLoadUnitInstance.js",
      "./model": "./dist/model/index.js",
      "./model/AbstractEggContext": "./dist/model/AbstractEggContext.js",
      "./model/ContextHandler": "./dist/model/ContextHandler.js",
      "./model/EggContext": "./dist/model/EggContext.js",
      "./model/EggObject": "./dist/model/EggObject.js",
      "./model/LoadUnitInstance": "./dist/model/LoadUnitInstance.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsgo --noEmit && tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@eggjs/core-decorator": "workspace:*",
    "@eggjs/lifecycle": "workspace:*",
    "@eggjs/metadata": "workspace:*",
    "@eggjs/tegg-common-util": "workspace:*",
    "@eggjs/tegg-types": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/module-test-util": "workspace:*",
    "@eggjs/tegg-loader": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-unused": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
