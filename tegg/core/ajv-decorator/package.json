{
  "name": "@eggjs/ajv-decorator",
  "version": "4.0.0-beta.35",
  "description": "tegg ajv decorator",
  "keywords": [
    "ajv",
    "decorator",
    "egg",
    "tegg",
    "typescript"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/core/ajv-decorator",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "tegg/core/ajv-decorator"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./enum": "./src/enum/index.ts",
    "./enum/TransformEnum": "./src/enum/TransformEnum.ts",
    "./error": "./src/error/index.ts",
    "./error/AjvInvalidParamError": "./src/error/AjvInvalidParamError.ts",
    "./type": "./src/type/index.ts",
    "./type/Ajv": "./src/type/Ajv.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./enum": "./dist/enum/index.js",
      "./enum/TransformEnum": "./dist/enum/TransformEnum.js",
      "./error": "./dist/error/index.js",
      "./error/AjvInvalidParamError": "./dist/error/AjvInvalidParamError.js",
      "./type": "./dist/type/index.js",
      "./type/Ajv": "./dist/type/Ajv.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsgo --noEmit && tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-unused": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
