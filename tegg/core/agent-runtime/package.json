{
  "name": "@eggjs/agent-runtime",
  "version": "4.0.2-beta.7",
  "description": "Agent runtime with store abstraction for Egg.js tegg",
  "keywords": [
    "agent",
    "egg",
    "runtime",
    "store",
    "tegg"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/core/agent-runtime",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "tegg/core/agent-runtime"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./AgentRuntime": "./src/AgentRuntime.ts",
    "./AgentStoreUtils": "./src/AgentStoreUtils.ts",
    "./HttpSSEWriter": "./src/HttpSSEWriter.ts",
    "./MessageConverter": "./src/MessageConverter.ts",
    "./OSSAgentStore": "./src/OSSAgentStore.ts",
    "./OSSObjectStorageClient": "./src/OSSObjectStorageClient.ts",
    "./RunBuilder": "./src/RunBuilder.ts",
    "./SSEWriter": "./src/SSEWriter.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./AgentRuntime": "./dist/AgentRuntime.js",
      "./AgentStoreUtils": "./dist/AgentStoreUtils.js",
      "./HttpSSEWriter": "./dist/HttpSSEWriter.js",
      "./MessageConverter": "./dist/MessageConverter.js",
      "./OSSAgentStore": "./dist/OSSAgentStore.js",
      "./OSSObjectStorageClient": "./dist/OSSObjectStorageClient.js",
      "./RunBuilder": "./dist/RunBuilder.js",
      "./SSEWriter": "./dist/SSEWriter.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eggjs/tegg-types": "workspace:*",
    "egg-logger": "catalog:",
    "oss-client": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
