{
  "name": "@eggjs/aop-runtime",
  "version": "4.0.0-beta.35",
  "description": "tegg aop runtime",
  "keywords": [
    "aop",
    "egg",
    "runtime",
    "tegg",
    "typescript"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/core/aop-runtime",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "author": "killagu <killa123@126.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "tegg/core/aop-runtime"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./AspectExecutor": "./src/AspectExecutor.ts",
    "./CrossCutGraphHook": "./src/CrossCutGraphHook.ts",
    "./EggObjectAopHook": "./src/EggObjectAopHook.ts",
    "./EggPrototypeCrossCutHook": "./src/EggPrototypeCrossCutHook.ts",
    "./LoadUnitAopHook": "./src/LoadUnitAopHook.ts",
    "./PointCutGraphHook": "./src/PointCutGraphHook.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./AspectExecutor": "./dist/AspectExecutor.js",
      "./CrossCutGraphHook": "./dist/CrossCutGraphHook.js",
      "./EggObjectAopHook": "./dist/EggObjectAopHook.js",
      "./EggPrototypeCrossCutHook": "./dist/EggPrototypeCrossCutHook.js",
      "./LoadUnitAopHook": "./dist/LoadUnitAopHook.js",
      "./PointCutGraphHook": "./dist/PointCutGraphHook.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsgo --noEmit && tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@eggjs/aop-decorator": "workspace:*",
    "@eggjs/core-decorator": "workspace:*",
    "@eggjs/metadata": "workspace:*",
    "@eggjs/tegg-common-util": "workspace:*",
    "@eggjs/tegg-runtime": "workspace:*",
    "@eggjs/tegg-types": "workspace:*",
    "koa-compose": "catalog:"
  },
  "devDependencies": {
    "@eggjs/module-test-util": "workspace:*",
    "@eggjs/tegg-loader": "workspace:*",
    "@types/koa-compose": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-unused": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "eggModule": {
    "name": "teggAopRuntime"
  }
}
