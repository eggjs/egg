  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./builder": "./dist/builder/index.js",
      "./builder/ScheduleMetaBuilder": "./dist/builder/ScheduleMetaBuilder.js",
      "./decorator": "./dist/decorator/index.js",
      "./decorator/Schedule": "./dist/decorator/Schedule.js",
      "./model": "./dist/model/index.js",
      "./model/ScheduleMetadata": "./dist/model/ScheduleMetadata.js",
