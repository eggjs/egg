{
  "name": "@eggjs/transaction-decorator",
  "version": "4.0.0-beta.35",
  "description": "tegg transaction decorator",
  "keywords": [
    "decorator",
    "egg",
    "tegg",
    "transaction",
    "typescript"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/core/transaction-decorator",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "author": "qile222 <chhxxc@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "tegg/core/transaction-decorator"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./builder": "./src/builder/index.ts",
    "./builder/TransactionMetaBuilder": "./src/builder/TransactionMetaBuilder.ts",
    "./decorator": "./src/decorator/index.ts",
    "./decorator/Transactional": "./src/decorator/Transactional.ts",
    "./util": "./src/util/index.ts",
    "./util/TransactionMetadataUtil": "./src/util/TransactionMetadataUtil.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./builder": "./dist/builder/index.js",
      "./builder/TransactionMetaBuilder": "./dist/builder/TransactionMetaBuilder.js",
      "./decorator": "./dist/decorator/index.js",
      "./decorator/Transactional": "./dist/decorator/Transactional.js",
      "./util": "./dist/util/index.js",
      "./util/TransactionMetadataUtil": "./dist/util/TransactionMetadataUtil.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsgo --noEmit && tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@eggjs/core-decorator": "workspace:*",
    "@eggjs/tegg-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-unused": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
