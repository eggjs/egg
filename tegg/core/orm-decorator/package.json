{
  "name": "@eggjs/orm-decorator",
  "version": "4.0.0-beta.35",
  "description": "tegg orm decorator",
  "keywords": [
    "egg",
    "runtime",
    "tegg",
    "typescript"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/core/orm-decorator",
  "bugs": {
