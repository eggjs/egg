{
  "name": "@eggjs/aop-decorator",
  "version": "4.0.0-beta.35",
  "description": "tegg aop decorator",
  "keywords": [
    "aop",
    "egg",
    "tegg",
    "typescript"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/core/aop-decorator",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "author": "killagu <killa123@126.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "tegg/core/aop-decorator"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./AspectMetaBuilder": "./src/AspectMetaBuilder.ts",
    "./CrosscutAdviceFactory": "./src/CrosscutAdviceFactory.ts",
    "./decorator": "./src/decorator/index.ts",
    "./decorator/Advice": "./src/decorator/Advice.ts",
    "./decorator/Crosscut": "./src/decorator/Crosscut.ts",
    "./decorator/Pointcut": "./src/decorator/Pointcut.ts",
    "./model": "./src/model/index.ts",
    "./model/Aspect": "./src/model/Aspect.ts",
    "./model/PointcutInfo": "./src/model/PointcutInfo.ts",
    "./util": "./src/util/index.ts",
    "./util/AdviceInfoUtil": "./src/util/AdviceInfoUtil.ts",
    "./util/AspectInfoUtil": "./src/util/AspectInfoUtil.ts",
    "./util/CrosscutInfoUtil": "./src/util/CrosscutInfoUtil.ts",
    "./util/PointcutAdviceInfoUtil": "./src/util/PointcutAdviceInfoUtil.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./AspectMetaBuilder": "./dist/AspectMetaBuilder.js",
      "./CrosscutAdviceFactory": "./dist/CrosscutAdviceFactory.js",
      "./decorator": "./dist/decorator/index.js",
      "./decorator/Advice": "./dist/decorator/Advice.js",
      "./decorator/Crosscut": "./dist/decorator/Crosscut.js",
      "./decorator/Pointcut": "./dist/decorator/Pointcut.js",
      "./model": "./dist/model/index.js",
      "./model/Aspect": "./dist/model/Aspect.js",
      "./model/PointcutInfo": "./dist/model/PointcutInfo.js",
      "./util": "./dist/util/index.js",
      "./util/AdviceInfoUtil": "./dist/util/AdviceInfoUtil.js",
      "./util/AspectInfoUtil": "./dist/util/AspectInfoUtil.js",
      "./util/CrosscutInfoUtil": "./dist/util/CrosscutInfoUtil.js",
      "./util/PointcutAdviceInfoUtil": "./dist/util/PointcutAdviceInfoUtil.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsgo --noEmit && tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@eggjs/core-decorator": "workspace:*",
    "@eggjs/tegg-common-util": "workspace:*",
    "@eggjs/tegg-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-unused": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
