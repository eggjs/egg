{
  "name": "@eggjs/tegg-config",
  "eggPlugin": {
    "name": "teggConfig"
  },
  "version": "4.0.0-beta.34",
  "description": "module config plugin for egg",
  "keywords": [
    "egg",
    "plugin",
    "typescript",
    "module",
    "config",
    "tegg"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent.ts",
    "./app": "./src/app.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./lib/ModuleScanner": "./src/lib/ModuleScanner.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "tsdown && npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/plugin/config",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:eggjs/egg.git",
    "directory": "tegg/plugin/config"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@eggjs/tegg-common-util": "workspace:*",
    "@eggjs/utils": "workspace:*"
  },
  "peerDependencies": {
    "egg": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@types/node": "catalog:",
    "egg": "workspace:*",
    "typescript": "catalog:",
    "tsdown": "catalog:",
    "unplugin-unused": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./agent": "./dist/agent.mjs",
      "./app": "./dist/app.mjs",
      "./config/config.default": "./dist/config/config.default.mjs",
      "./lib/ModuleScanner": "./dist/lib/ModuleScanner.mjs",
      "./types": "./dist/types.mjs",
      "./package.json": "./package.json"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts"
}
