{
  "name": "@eggjs/orm-plugin",
  "eggPlugin": {
    "name": "teggOrm",
    "dependencies": [
      "tegg"
    ]
  },
  "version": "4.0.0-beta.34",
  "description": "orm decorator for egg",
  "keywords": [
    "egg",
    "plugin",
    "typescript",
    "module",
    "tegg",
    "orm",
    "leoric"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./lib/DataSourceManager": "./src/lib/DataSourceManager.ts",
    "./lib/LeoricRegister": "./src/lib/LeoricRegister.ts",
    "./lib/ModelProtoHook": "./src/lib/ModelProtoHook.ts",
    "./lib/ModelProtoManager": "./src/lib/ModelProtoManager.ts",
    "./lib/ORMLoadUnitHook": "./src/lib/ORMLoadUnitHook.ts",
    "./lib/SingletonModelObject": "./src/lib/SingletonModelObject.ts",
    "./lib/SingletonModelProto": "./src/lib/SingletonModelProto.ts",
    "./lib/SingletonORM": "./src/lib/SingletonORM.ts",
    "./lib/types": "./src/lib/types.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "tsdown && npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit --project tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "pretest": "node ./test/fixtures/prepare.js"
  },
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/plugin/orm",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:eggjs/egg.git",
    "directory": "tegg/plugin/orm"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@eggjs/core-decorator": "workspace:*",
    "@eggjs/module-common": "workspace:*",
    "@eggjs/lifecycle": "workspace:*",
    "@eggjs/metadata": "workspace:*",
    "@eggjs/orm-decorator": "workspace:*",
    "@eggjs/tegg-runtime": "workspace:*",
    "leoric": "catalog:",
    "sdk-base": "catalog:"
  },
  "peerDependencies": {
    "@eggjs/tegg-plugin": "workspace:*",
    "egg": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/module-test-util": "workspace:*",
    "@eggjs/tegg": "workspace:*",
    "@eggjs/tegg-config": "workspace:*",
    "@eggjs/tegg-plugin": "workspace:*",
    "@eggjs/tracer": "workspace:*",
    "@types/node": "catalog:",
    "egg": "workspace:*",
    "mysql2": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-unused": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./app": "./dist/app.mjs",
      "./config/config.default": "./dist/config/config.default.mjs",
      "./lib/DataSourceManager": "./dist/lib/DataSourceManager.mjs",
      "./lib/LeoricRegister": "./dist/lib/LeoricRegister.mjs",
      "./lib/ModelProtoHook": "./dist/lib/ModelProtoHook.mjs",
      "./lib/ModelProtoManager": "./dist/lib/ModelProtoManager.mjs",
      "./lib/ORMLoadUnitHook": "./dist/lib/ORMLoadUnitHook.mjs",
      "./lib/SingletonModelObject": "./dist/lib/SingletonModelObject.mjs",
      "./lib/SingletonModelProto": "./dist/lib/SingletonModelProto.mjs",
      "./lib/SingletonORM": "./dist/lib/SingletonORM.mjs",
      "./lib/types": "./dist/lib/types.mjs",
      "./types": "./dist/types.mjs",
      "./package.json": "./package.json"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts"
}
