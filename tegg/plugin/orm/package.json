{
  "name": "@eggjs/orm-plugin",
  "version": "4.0.2-beta.9",
  "description": "orm decorator for egg",
  "keywords": [
    "egg",
    "leoric",
    "module",
    "orm",
    "plugin",
    "tegg",
    "typescript"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/plugin/orm",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "tegg/plugin/orm"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./lib/DataSourceManager": "./src/lib/DataSourceManager.ts",
    "./lib/LeoricRegister": "./src/lib/LeoricRegister.ts",
    "./lib/ModelProtoHook": "./src/lib/ModelProtoHook.ts",
    "./lib/ModelProtoManager": "./src/lib/ModelProtoManager.ts",
    "./lib/ORMLoadUnitHook": "./src/lib/ORMLoadUnitHook.ts",
    "./lib/SingletonModelObject": "./src/lib/SingletonModelObject.ts",
    "./lib/SingletonModelProto": "./src/lib/SingletonModelProto.ts",
    "./lib/SingletonORM": "./src/lib/SingletonORM.ts",
    "./lib/types": "./src/lib/types.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./app": "./dist/app.js",
      "./config/config.default": "./dist/config/config.default.js",
      "./lib/DataSourceManager": "./dist/lib/DataSourceManager.js",
      "./lib/LeoricRegister": "./dist/lib/LeoricRegister.js",
      "./lib/ModelProtoHook": "./dist/lib/ModelProtoHook.js",
      "./lib/ModelProtoManager": "./dist/lib/ModelProtoManager.js",
      "./lib/ORMLoadUnitHook": "./dist/lib/ORMLoadUnitHook.js",
      "./lib/SingletonModelObject": "./dist/lib/SingletonModelObject.js",
      "./lib/SingletonModelProto": "./dist/lib/SingletonModelProto.js",
      "./lib/SingletonORM": "./dist/lib/SingletonORM.js",
      "./lib/types": "./dist/lib/types.js",
      "./types": "./dist/types.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit --project tsconfig.typecheck.json",
    "pretest": "node ./test/fixtures/prepare.js"
  },
  "dependencies": {
    "@eggjs/core-decorator": "workspace:*",
    "@eggjs/lifecycle": "workspace:*",
    "@eggjs/metadata": "workspace:*",
    "@eggjs/module-common": "workspace:*",
    "@eggjs/orm-decorator": "workspace:*",
    "@eggjs/tegg-runtime": "workspace:*",
    "leoric": "catalog:",
    "sdk-base": "catalog:"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/module-test-util": "workspace:*",
    "@eggjs/tegg": "workspace:*",
    "@eggjs/tegg-config": "workspace:*",
    "@eggjs/tegg-plugin": "workspace:*",
    "@eggjs/tracer": "workspace:*",
    "@types/node": "catalog:",
    "egg": "workspace:*",
    "mysql2": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@eggjs/tegg-plugin": "workspace:*",
    "egg": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "eggPlugin": {
    "name": "teggOrm",
    "dependencies": [
      "tegg"
    ]
  }
