{
  "name": "@eggjs/ajv-plugin",
  "version": "4.0.2-beta.7",
  "description": "ajv plugin for egg and tegg",
  "keywords": [
    "ajv",
    "egg",
    "module",
    "plugin",
    "tegg",
    "typescript"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/plugin/ajv",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "tegg/plugin/ajv"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/Ajv": "./src/lib/Ajv.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./lib/Ajv": "./dist/lib/Ajv.js",
      "./types": "./dist/types.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@eggjs/ajv-decorator": "workspace:*",
    "@eggjs/ajv-formats": "^3.0.1",
    "@eggjs/ajv-keywords": "^5.1.0",
    "@eggjs/core-decorator": "workspace:*",
    "@eggjs/lifecycle": "workspace:*",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@eggjs/controller-plugin": "workspace:*",
    "@eggjs/mock": "workspace:*",
    "@eggjs/tegg": "workspace:*",
    "@eggjs/tegg-config": "workspace:*",
    "@eggjs/tegg-plugin": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "eggModule": {
    "name": "teggAjv"
  },
  "eggPlugin": {
    "name": "teggAjv",
    "strict": false,
    "dependencies": [
      "tegg"
    ]
  }
}
