{
  "name": "@eggjs/aop-plugin",
  "version": "4.0.2-beta.9",
  "description": "tegg aop plugin",
  "keywords": [
    "aop",
    "decorator",
    "egg",
    "tegg",
    "typescript"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/plugin/aop",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "tegg/plugin/aop"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./lib/AopContextHook": "./src/lib/AopContextHook.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./app": "./dist/app.js",
      "./lib/AopContextHook": "./dist/lib/AopContextHook.js",
      "./types": "./dist/types.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@eggjs/aop-decorator": "workspace:*",
    "@eggjs/aop-runtime": "workspace:*",
    "@eggjs/core-decorator": "workspace:*",
    "@eggjs/lifecycle": "workspace:*",
    "@eggjs/metadata": "workspace:*",
    "@eggjs/module-common": "workspace:*",
    "@eggjs/tegg-runtime": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/tegg": "workspace:*",
    "@eggjs/tegg-config": "workspace:*",
    "@eggjs/tegg-plugin": "workspace:*",
    "@types/node": "catalog:",
    "egg": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@eggjs/tegg-plugin": "workspace:*",
    "egg": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "eggPlugin": {
    "name": "teggAop",
    "dependencies": [
      "tegg"
    ]
  }
}
