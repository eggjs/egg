{
  "name": "@eggjs/standalone",
  "version": "4.0.0-beta.35",
  "description": "tegg standalone",
  "keywords": [
    "async",
    "background",
    "egg",
    "standalone",
    "tegg",
    "typescript"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/standalone/standalone",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "author": "killagu <killa123@126.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "tegg/standalone/standalone"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ConfigSourceLoadUnitHook": "./src/ConfigSourceLoadUnitHook.ts",
    "./EggModuleLoader": "./src/EggModuleLoader.ts",
    "./main": "./src/main.ts",
    "./ModuleConfig": "./src/ModuleConfig.ts",
    "./Runner": "./src/Runner.ts",
    "./StandaloneContext": "./src/StandaloneContext.ts",
    "./StandaloneContextHandler": "./src/StandaloneContextHandler.ts",
    "./StandaloneContextImpl": "./src/StandaloneContextImpl.ts",
    "./StandaloneInnerObject": "./src/StandaloneInnerObject.ts",
    "./StandaloneInnerObjectProto": "./src/StandaloneInnerObjectProto.ts",
    "./StandaloneLoadUnit": "./src/StandaloneLoadUnit.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./ConfigSourceLoadUnitHook": "./dist/ConfigSourceLoadUnitHook.js",
      "./EggModuleLoader": "./dist/EggModuleLoader.js",
      "./main": "./dist/main.js",
      "./ModuleConfig": "./dist/ModuleConfig.js",
      "./Runner": "./dist/Runner.js",
      "./StandaloneContext": "./dist/StandaloneContext.js",
      "./StandaloneContextHandler": "./dist/StandaloneContextHandler.js",
      "./StandaloneContextImpl": "./dist/StandaloneContextImpl.js",
      "./StandaloneInnerObject": "./dist/StandaloneInnerObject.js",
      "./StandaloneInnerObjectProto": "./dist/StandaloneInnerObjectProto.js",
      "./StandaloneLoadUnit": "./dist/StandaloneLoadUnit.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "clean": "tsc -b --clean && rimraf dist *.tsbuildinfo",
    "typecheck": "tsgo --noEmit && tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@eggjs/aop-runtime": "workspace:*",
    "@eggjs/dal-plugin": "workspace:*",
    "@eggjs/lifecycle": "workspace:*",
    "@eggjs/metadata": "workspace:*",
    "@eggjs/tegg": "workspace:*",
    "@eggjs/tegg-common-util": "workspace:*",
    "@eggjs/tegg-loader": "workspace:*",
    "@eggjs/tegg-runtime": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/ajv-plugin": "workspace:*",
    "@eggjs/bin": "workspace:*",
    "@eggjs/core-decorator": "workspace:*",
    "@eggjs/dal-decorator": "workspace:*",
    "@eggjs/utils": "workspace:*",
    "@types/node": "catalog:",
    "mm": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-unused": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
