{
  "name": "@eggjs/service-worker-runtime",
  "version": "4.0.2-beta.19",
  "description": "protocol-agnostic tegg service worker runtime: @Runner event dispatch, context event injection and background task wiring",
  "keywords": [
    "egg",
    "service worker",
    "standalone",
    "tegg",
    "typescript"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/tegg/standalone/service-worker-runtime",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "tegg/standalone/service-worker-runtime"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
