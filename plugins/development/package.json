{
  "name": "@eggjs/development",
  "version": "5.0.2-beta.7",
  "description": "development tool for egg",
  "keywords": [
    "egg",
    "egg-plugin",
    "eggPlugin",
    "plugin"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/plugins/development",
  "bugs": "https://github.com/eggjs/egg/issues",
  "license": "MIT",
  "author": "jtyjty99999",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "plugins/development"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent.ts",
    "./app": "./src/app.ts",
    "./app/middleware/egg_loader_trace": "./src/app/middleware/egg_loader_trace.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/utils.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./agent": "./dist/agent.js",
      "./app": "./dist/app.js",
      "./app/middleware/egg_loader_trace": "./dist/app/middleware/egg_loader_trace.js",
      "./config/config.default": "./dist/config/config.default.js",
      "./types": "./dist/types.js",
      "./utils": "./dist/utils.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "debounce": "catalog:",
    "multimatch": "catalog:",
    "utility": "catalog:"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/supertest": "workspace:*",
    "egg": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "egg": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
