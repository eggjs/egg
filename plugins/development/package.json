{
  "name": "@eggjs/development",
  "version": "5.0.0-beta.34",
  "description": "development tool for egg",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./agent": "./dist/agent.mjs",
      "./app": "./dist/app.mjs",
      "./app/middleware/egg_loader_trace": "./dist/app/middleware/egg_loader_trace.mjs",
      "./config/config.default": "./dist/config/config.default.mjs",
      "./types": "./dist/types.mjs",
      "./utils": "./dist/utils.mjs",
      "./package.json": "./package.json"
    }
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent.ts",
    "./app": "./src/app.ts",
    "./app/middleware/egg_loader_trace": "./src/app/middleware/egg_loader_trace.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/utils.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.mts",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "keywords": [
    "egg",
    "plugin",
    "egg-plugin",
    "eggPlugin"
  ],
  "dependencies": {
    "debounce": "catalog:",
    "multimatch": "catalog:",
    "utility": "catalog:"
  },
  "peerDependencies": {
    "egg": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/supertest": "workspace:*",
    "@eggjs/tsconfig": "workspace:*",
    "egg": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown && rimraf dist *.tsbuildinfo && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git",
    "directory": "plugins/development"
  },
  "bugs": "https://github.com/eggjs/egg/issues",
  "homepage": "https://github.com/eggjs/egg/tree/next/plugins/development",
  "author": "jtyjty99999",
  "license": "MIT"
}
