  "repository": {
    "type": "git",
    "url": "https://github.com/eggjs/egg.git",
    "directory": "plugins/schedule"
  },
  "homepage": "https://github.com/eggjs/egg/tree/next/plugins/schedule",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
