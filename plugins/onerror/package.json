{
  "name": "@eggjs/onerror",
  "version": "4.0.0-beta.34",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./agent": "./dist/agent.mjs",
      "./app": "./dist/app.mjs",
      "./config/config.default": "./dist/config/config.default.mjs",
      "./lib/error_view": "./dist/lib/error_view.mjs",
      "./lib/utils": "./dist/lib/utils.mjs",
      "./types": "./dist/types.mjs",
      "./package.json": "./package.json"
    }
  },
  "description": "error handler for egg",
  "homepage": "https://github.com/eggjs/egg/tree/next/plugins/onerror",
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git",
    "directory": "plugins/onerror"
  },
  "keywords": [
    "egg",
    "egg-plugin",
    "onerror"
  ],
  "author": "dead_horse",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "cookie": "catalog:",
    "koa-onerror": "catalog:",
    "mustache": "catalog:",
    "stack-trace": "catalog:"
  },
  "peerDependencies": {
    "egg": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@types/mustache": "catalog:",
    "@types/stack-trace": "catalog:",
    "egg": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown && rimraf dist *.tsbuildinfo && tsc -p tsconfig.build.json && cp src/lib/onerror_page.mustache.html dist/lib/onerror_page.mustache.html",
    "prepublishOnly": "pnpm run build"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent.ts",
    "./app": "./src/app.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./lib/error_view": "./src/lib/error_view.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.mts",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs"
}
