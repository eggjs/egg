{
  "name": "@eggjs/view-nunjucks",
  "version": "3.0.0-beta.34",
  "description": "nunjucks view plugin for egg",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./app/extend/application": "./src/app/extend/application.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./config/config.local": "./src/config/config.local.ts",
    "./lib/engine": "./src/lib/engine.ts",
    "./lib/environment": "./src/lib/environment.ts",
    "./lib/file_loader": "./src/lib/file_loader.ts",
    "./lib/helper": "./src/lib/helper.ts",
    "./lib/view": "./src/lib/view.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./app": "./dist/app.mjs",
      "./app/extend/application": "./dist/app/extend/application.mjs",
      "./config/config.default": "./dist/config/config.default.mjs",
      "./config/config.local": "./dist/config/config.local.mjs",
      "./lib/engine": "./dist/lib/engine.mjs",
      "./lib/environment": "./dist/lib/environment.mjs",
      "./lib/file_loader": "./dist/lib/file_loader.mjs",
      "./lib/helper": "./dist/lib/helper.mjs",
      "./lib/view": "./dist/lib/view.mjs",
      "./types": "./dist/types.mjs",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && rimraf dist *.tsbuildinfo && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "egg",
    "eggPlugin",
    "egg-plugin",
    "egg-view",
    "nunjucks",
    "view",
    "template"
  ],
  "dependencies": {
    "nunjucks": "catalog:"
  },
  "peerDependencies": {
    "@eggjs/view": "workspace:*",
    "egg": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/view": "workspace:*",
    "@types/common-tags": "catalog:",
    "@types/nunjucks": "catalog:",
    "cheerio": "catalog:",
    "common-tags": "catalog:",
    "egg": "workspace:*",
    "marked": "catalog:",
    "nunjucks-markdown": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "plugins/view-nunjucks"
  },
  "bugs": "https://github.com/eggjs/egg/issues",
  "homepage": "https://github.com/eggjs/egg/tree/next/plugins/view-nunjucks#readme",
  "author": "TZ <atian25@qq.com>",
  "license": "MIT",
