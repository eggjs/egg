{
  "name": "@eggjs/i18n",
  "version": "4.0.0-beta.34",
  "description": "i18n plugin for egg",
  "keywords": [
    "egg",
    "egg-plugin",
    "eggPlugin",
    "i18n"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git",
    "directory": "plugins/i18n"
  },
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "homepage": "https://github.com/eggjs/egg/tree/next/plugins/i18n#readme",
  "author": "gxcsoccer <gxcsoccer@126.com>",
  "license": "MIT",
  "engines": {
    "node": ">= 22.18.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./app/extend/application": "./src/app/extend/application.ts",
    "./app/extend/context": "./src/app/extend/context.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./locales": "./src/locales.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/utils.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./app": "./dist/app.mjs",
      "./app/extend/application": "./dist/app/extend/application.mjs",
      "./app/extend/context": "./dist/app/extend/context.mjs",
      "./config/config.default": "./dist/config/config.default.mjs",
      "./locales": "./dist/locales.mjs",
      "./types": "./dist/types.mjs",
      "./utils": "./dist/utils.mjs",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@eggjs/utils": "workspace:*",
    "humanize-ms": "catalog:",
    "ini": "catalog:",
    "js-yaml": "catalog:",
    "utility": "catalog:"
  },
  "peerDependencies": {
    "egg": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/tsconfig": "workspace:*",
    "@types/ini": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "egg": "workspace:*",
    "egg-view-nunjucks": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsdown && rimraf dist *.tsbuildinfo && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts"
}
