{
  "name": "@eggjs/static",
  "version": "4.0.2-beta.9",
  "description": "static server plugin for egg",
  "keywords": [
    "egg",
    "egg-plugin",
    "eggPlugin",
    "static"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/plugins/static",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "author": "dead_horse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "plugins/static"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./app/middleware/static": "./src/app/middleware/static.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./config/config.prod": "./src/config/config.prod.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./app": "./dist/app.js",
      "./app/middleware/static": "./dist/app/middleware/static.js",
      "./config/config.default": "./dist/config/config.default.js",
      "./config/config.prod": "./dist/config/config.prod.js",
      "./types": "./dist/types.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@eggjs/koa-static-cache": "workspace:*",
    "koa-compose": "catalog:",
    "koa-range": "catalog:",
    "ylru": "catalog:"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@types/koa-compose": "catalog:",
    "@types/koa-range": "catalog:",
    "egg": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "egg": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
