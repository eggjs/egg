{
  "name": "@eggjs/multipart",
  "version": "5.0.0-beta.34",
  "description": "Multipart plugin for egg",
  "keywords": [
    "egg",
    "egg-plugin",
    "eggPlugin",
    "multipart"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git",
    "directory": "plugins/multipart"
  },
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "homepage": "https://github.com/eggjs/egg/tree/next/plugins/multipart#readme",
  "author": "gxcsoccer <gxcsoccer@126.com>",
  "license": "MIT",
  "engines": {
    "node": ">= 22.18.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./app/extend/context": "./src/app/extend/context.ts",
    "./app/middleware/multipart": "./src/app/middleware/multipart.ts",
    "./app/schedule/clean_tmpdir": "./src/app/schedule/clean_tmpdir.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./lib/LimitError": "./src/lib/LimitError.ts",
    "./lib/MultipartFileTooLargeError": "./src/lib/MultipartFileTooLargeError.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./app": "./dist/app.mjs",
      "./app/extend/context": "./dist/app/extend/context.mjs",
      "./app/middleware/multipart": "./dist/app/middleware/multipart.mjs",
      "./app/schedule/clean_tmpdir": "./dist/app/schedule/clean_tmpdir.mjs",
      "./config/config.default": "./dist/config/config.default.mjs",
      "./lib/LimitError": "./dist/lib/LimitError.mjs",
      "./lib/MultipartFileTooLargeError": "./dist/lib/MultipartFileTooLargeError.mjs",
      "./lib/utils": "./dist/lib/utils.mjs",
      "./types": "./dist/types.mjs",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@eggjs/path-matching": "workspace:*",
    "bytes": "catalog:",
    "co-busboy": "catalog:",
    "dayjs": "catalog:"
  },
  "peerDependencies": {
    "egg": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/schedule": "workspace:*",
    "@eggjs/tsconfig": "workspace:*",
    "@types/bytes": "catalog:",
    "@types/node": "catalog:",
    "egg": "workspace:*",
    "formstream": "catalog:",
    "is-type-of": "catalog:",
    "stream-wormhole": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "urllib": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsdown && rimraf dist *.tsbuildinfo && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run lint:fix && vitest",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts"
}
