{
  "name": "@eggjs/typebox-validate",
  "version": "4.0.2-beta.7",
  "description": "another validate for typescript egg projects",
  "keywords": [
    "ajv",
    "egg",
    "egg-plugin",
    "eggPlugin",
    "eggjs",
    "typebox",
    "validate"
  ],
  "homepage": "https://github.com/eggjs/egg/tree/next/plugins/typebox-validate",
  "bugs": {
    "url": "https://github.com/eggjs/egg/issues"
  },
  "license": "MIT",
  "author": "xiekw2010",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggjs/egg.git",
    "directory": "plugins/typebox-validate"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./app/extend/context": "./src/app/extend/context.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./decorator": "./src/decorator.ts",
    "./typebox": "./src/typebox.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./app": "./dist/app.js",
      "./app/extend/context": "./dist/app/extend/context.js",
      "./config/config.default": "./dist/config/config.default.js",
      "./decorator": "./dist/decorator.js",
      "./typebox": "./dist/typebox.js",
      "./types": "./dist/types.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "ajv-keywords": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@types/node": "catalog:",
    "egg": "workspace:*",
    "semver": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "egg": "workspace:*"
  },
  "engines": {
    "node": ">= 22.18.0"
  }
}
