{
  "name": "@eggjs/watcher",
  "version": "5.0.0-beta.15",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./agent": "./dist/agent.js",
      "./app": "./dist/app.js",
      "./config/config.default": "./dist/config/config.default.js",
      "./config/config.local": "./dist/config/config.local.js",
      "./config/config.unittest": "./dist/config/config.unittest.js",
      "./lib/boot": "./dist/lib/boot.js",
      "./lib/event-sources": "./dist/lib/event-sources/index.js",
      "./lib/event-sources/base": "./dist/lib/event-sources/base.js",
      "./lib/event-sources/default": "./dist/lib/event-sources/default.js",
      "./lib/event-sources/development": "./dist/lib/event-sources/development.js",
      "./lib/utils": "./dist/lib/utils.js",
      "./lib/watcher": "./dist/lib/watcher.js",
      "./types": "./dist/types.js",
      "./package.json": "./package.json"
    }
  },
  "description": "file watcher plugin for egg",
  "eggPlugin": {
    "name": "watcher"
  },
  "scripts": {
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "homepage": "https://github.com/eggjs/egg/tree/next/plugins/watcher",
  "repository": {
    "type": "git",
    "url": "git://github.com/eggjs/egg.git",
    "directory": "plugins/watcher"
  },
  "keywords": [
    "egg-watcher",
    "egg",
    "watcher",
    "watch"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@eggjs/utils": "workspace:*",
    "camelcase": "catalog:",
    "sdk-base": "catalog:"
  },
  "peerDependencies": {
    "egg": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/mock": "workspace:*",
    "@eggjs/tsconfig": "workspace:*",
    "@eggjs/utils": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent.ts",
    "./app": "./src/app.ts",
    "./config/config.default": "./src/config/config.default.ts",
    "./config/config.local": "./src/config/config.local.ts",
    "./config/config.unittest": "./src/config/config.unittest.ts",
    "./lib/boot": "./src/lib/boot.ts",
    "./lib/event-sources": "./src/lib/event-sources/index.ts",
    "./lib/event-sources/base": "./src/lib/event-sources/base.ts",
    "./lib/event-sources/default": "./src/lib/event-sources/default.ts",
    "./lib/event-sources/development": "./src/lib/event-sources/development.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/watcher": "./src/lib/watcher.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js"
}
