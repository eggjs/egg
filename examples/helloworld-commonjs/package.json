{
  "name": "helloworld-commonjs",
  "version": "1.0.0",
  "private": true,
  "description": "Hello World example using CommonJS",
  "type": "commonjs",
  "scripts": {
    "dev": "egg-bin dev",
    "debug": "egg-bin debug",
    "test": "egg-bin test",
    "cov": "egg-bin cov",
    "lint": "oxlint",
    "ci": "pnpm run lint && pnpm run cov",
    "start": "egg-scripts start --daemon",
    "stop": "egg-scripts stop"
  },
  "dependencies": {
    "egg": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/bin": "workspace:*",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
