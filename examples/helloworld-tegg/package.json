{
  "name": "helloworld-tegg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hello World example using tegg",
  "egg": {
    "typescript": true
  },
  "dependencies": {
    "@eggjs/scripts": "workspace:",
    "@eggjs/tracer": "workspace:*",
    "egg": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/bin": "workspace:*",
    "@eggjs/mock": "workspace:*",
    "@eggjs/tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "dev": "egg-bin dev",
    "debug": "egg-bin debug",
    "test": "vitest run",
    "cov": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "ci": "pnpm run lint && pnpm run cov",
    "prepublishOnly": "pnpm run build",
    "start": "egg-scripts start --daemon",
    "stop": "egg-scripts stop",
    "typecheck": "tsc --noEmit",
    "build": "tsdown"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    "./app": "./app.ts",
    "./app/biz/Foo": "./app/biz/Foo.ts",
    "./app/biz/HelloService": "./app/biz/HelloService.ts",
    "./app/biz/WorldService": "./app/biz/WorldService.ts",
    "./app/port/controller/ArgsController": "./app/port/controller/ArgsController.ts",
    "./app/port/controller/HomeController": "./app/port/controller/HomeController.ts",
    "./app/port/controller/SimpleController": "./app/port/controller/SimpleController.ts",
    "./app/port/schedule/CronDemo": "./app/port/schedule/CronDemo.ts",
    "./app/port/schedule/Demo": "./app/port/schedule/Demo.ts",
    "./config/config.default": "./config/config.default.ts",
    "./config/plugin": "./config/plugin.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./app": "./dist/app.mjs",
      "./app/biz/Foo": "./dist/app/biz/Foo.mjs",
      "./app/biz/HelloService": "./dist/app/biz/HelloService.mjs",
      "./app/biz/WorldService": "./dist/app/biz/WorldService.mjs",
      "./app/port/controller/ArgsController": "./dist/app/port/controller/ArgsController.mjs",
      "./app/port/controller/HomeController": "./dist/app/port/controller/HomeController.mjs",
      "./app/port/controller/SimpleController": "./dist/app/port/controller/SimpleController.mjs",
      "./app/port/schedule/CronDemo": "./dist/app/port/schedule/CronDemo.mjs",
      "./app/port/schedule/Demo": "./dist/app/port/schedule/Demo.mjs",
      "./config/config.default": "./dist/config/config.default.mjs",
      "./config/plugin": "./dist/config/plugin.mjs",
      "./package.json": "./package.json"
    }
  }
}
