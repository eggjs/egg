{
  "name": "@examples/helloworld-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hello World example using TypeScript",
  "egg": {
    "typescript": true
  },
  "dependencies": {
    "egg": "workspace:*"
  },
  "devDependencies": {
    "@eggjs/bin": "catalog:",
    "@eggjs/tsconfig": "workspace:*",
    "typescript": "catalog:"
  },
  "scripts": {
    "dev": "egg-bin dev",
    "debug": "egg-bin debug",
    "test": "egg-bin test",
    "cov": "egg-bin cov",
    "lint": "eslint . --ext .ts",
    "ci": "pnpm run lint && pnpm run cov",
    "start": "egg-scripts start --daemon",
    "stop": "egg-scripts stop"
  },
  "engines": {
    "node": ">= 20.19.0"
  }
}
