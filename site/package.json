{
  "name": "@eggjs/site",
  "private": true,
  "description": "Eggjs documentation site",
  "dependencies": {
    "egg": "workspace:*",
    "dumi": "catalog:"
  },
  "devDependencies": {
    "prettier": "catalog:"
  },
  "scripts": {
    "dev": "APP_ROOT=. dumi dev",
    "build:skip": "APP_ROOT=. dumi build",
    "prettier": "prettier --config .prettierrc --ignore-path .prettierignore --write \"**/*.{js,jsx,tsx,ts,less,md,json}\""
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
